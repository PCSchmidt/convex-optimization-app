    {
      "id": 106,
      "type": "table",
      "title": "Recent errors (by endpoint / class)",
      "description": "Current cumulative error counts per (endpoint, method, error_class) series. error_class is the app's bounded taxonomy: validation_error (bad request body), inapplicable_pair (method not applicable to problem), server_error (solver crash).",
      "datasource": {
        "type": "prometheus",
        "uid": "convex-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "convex-prom"
          },
          "expr": "topk(10, convex_optimization_errors_total)",
          "refId": "A",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "endpoint": 0,
              "method": 1,
              "error_class": 2,
              "Value": 3
            },
            "renameByName": {
              "Value": "count"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "count"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "noValue": "No errors recorded"
