{
  "uid": "convex-optimization-app",
  "title": "Convex Optimization App — API & Solver Observability",
  "description": "Local compose observability for the convex-optimization app (Phase 6). Top rows: generic HTTP health/traffic/latency/error signals. Bottom row: the app's convex domain signals (solve rate, solve latency, convergence success/failure, iteration counts, final objective gap) from the convex_optimization_* families on GET /metrics/prometheus. Counters are in-process in the api container: they reset when the api service restarts, so dashboards show data only for traffic since the last api restart. Generate traffic with the README runbook (health checks + POST /solve over the committed offline fixtures).",
  "tags": [
    "convex-optimization",
    "portfolio",
    "local-compose"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 101,
      "type": "stat",
      "title": "App health (up)",
      "description": "1 while the FastAPI app is serving (convex_optimization_up). Red means the scrape target is down.",
      "datasource": {
        "type": "prometheus",
        "uid": "convex-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "convex-prom"
          },
          "expr": "convex_optimization_up",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "noValue": "No data"
      }
    },
